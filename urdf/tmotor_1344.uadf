<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find tobas_description)/urdf/components/common.xacro"/>

  <xacro:macro name="tmotor_1344" params="parent index direction *origin">

    <xacro:property name="diameter" value="${13*inch2meter}"/>
    <xacro:property name="radius" value="${diameter/2}"/>
    <xacro:property name="height" value="0.012"/>
    <xacro:property name="mass" value="0.0142"/>

    <xacro:property name="link_name" value="propeller_${index}"/>
    <xacro:property name="joint_name" value="${link_name}_joint"/>

    <joint name="${joint_name}" type="thrust">
      <parent link="${parent}"/>
      <child link="${link_name}"/>
      <xacro:insert_block name="origin"/>
      <axis xyz="0 0 1"/>
      <direction value="${direction}"/>
    </joint>

    <link name="${link_name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://tobas_voliro_like_description/meshes/tmotor_1344_${direction}.stl" scale="1 1 1"/>
        </geometry>
        <xacro:insert_block name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia radius="${radius}" length="${height}" mass="${mass}"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
